OCR_API_BASE_URL=https://your-host/api/ocr
OCR_IMAGE_HOST_PREFIX=https://your-host
OCR_IMAGE_LOCAL_ROOT=
OCR_API_KEY=replace-me
OCR_INCLUDE_DONE=0
OCR_VERSION=2026-05-31
OCR_SHARD_COUNT=1
OCR_SHARD_INDEX=0

LM_STUDIO_API_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=gemma-3-27b-it
LM_STUDIO_API_KEY=lm-studio
# vLLM 経由の Gemma 4 を使う場合の推奨設定:
# - MAX_TOKENS は JSON 全体が完成する余裕として 8192
# - reasoning は本文 token を食い切る暴走の原因になるため off
# - frequency_penalty 0.3 で反復ループ (\n\n... / 同じ文字繰り返し) を抑止
LM_STUDIO_MAX_TOKENS=8192
LM_STUDIO_ENABLE_THINKING=false
LM_STUDIO_FREQUENCY_PENALTY=0.3
# 任意: thinking を ON にしたい場合の上限。reasoning がここに達すると vLLM が
# 強制的に reasoning を打ち切って本文生成へ遷移させる。
# LM_STUDIO_THINKING_TOKEN_BUDGET=1024
# 任意: vLLM サーバー起動時 --mm-processor-kwargs '{"max_soft_tokens": 560}' を
# 設定している場合に、リクエストレベルで同じ値を渡すと整合する。
# サポート値: 70 / 140 / 280 (デフォルト) / 560 / 1120
# LM_STUDIO_MAX_SOFT_TOKENS=560

IDLE_SLEEP_SEC=60.0
REQUEST_TIMEOUT_SEC=30
REQUEST_RETRY_COUNT=3
REQUEST_RETRY_BACKOFF_SEC=2.0
LM_STUDIO_TIMEOUT_SEC=180
IMAGE_MAX_DIM=1280
FETCH_PAGE_SIZE=100
MAX_ITEMS_PER_CYCLE=50
